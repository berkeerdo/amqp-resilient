{
  "name": "amqp-resilient",
  "version": "1.2.0",
  "description": "Production-ready AMQP client with retry, reconnection, and resilience patterns for Node.js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run --exclude tests/integration.test.ts",
    "test:unit": "vitest run --exclude tests/integration.test.ts",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "amqp",
    "rabbitmq",
    "rabbitmq-client",
    "queue",
    "message-queue",
    "message-broker",
    "resilient",
    "retry",
    "reconnection",
    "circuit-breaker",
    "dead-letter-queue",
    "dlq",
    "exponential-backoff",
    "health-check",
    "consumer",
    "publisher",
    "microservices",
    "typescript",
    "nodejs",
    "esm"
  ],
  "author": "berkeerdo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berkeerdo/amqp-resilient.git"
  },
  "bugs": {
    "url": "https://github.com/berkeerdo/amqp-resilient/issues"
  },
  "homepage": "https://github.com/berkeerdo/amqp-resilient#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "amqplib": ">=0.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "amqplib": "^0.10.9",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
